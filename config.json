{
  "embed_model": "intfloat/multilingual-e5-small",
  "embed_device": "auto",
  "embed_dim": 384,
  "chunk_tokens": 330,
  "chunk_overlap": 60,
  "chunking_strategy": "parent_child",
  "parent_tokens": 1200,
  "agentic_enabled": true,
  "agentic_max_steps": 3,
  "agentic_strategy": "auto",
  "llm_base_url": "http://localhost:1234/v1",
  "llm_model": "default",
  "llm_temperature": 0.3,
  "llm_max_tokens": 2048,
  "max_tokens_default": 2048,
  "max_tokens_quiz": 4096,
  "max_tokens_summary": 4096,
  "chat_mode": "agentic",
  "show_thinking": false,
  "context_word_budget": 3000,
  "chunk_word_cap": 300,
  "history_char_budget": 10000,
  "history_msg_limit": 12,
  "catalog_enabled": true,
  "catalog_clarify_threshold": 20,
  "catalog_max_rows": 200,
  "catalog_semantic_pool": 500,
  "summary_strategy": "map_reduce",
  "summary_max_chunks": 40,
  "summary_context_budget": 8000,
  "quiz_default_count": 10,
  "quiz_output_format": "markdown",
  "retrieval_top_k": 10,
  "relevance_threshold": 0.8,
  "max_retrieval_hops": 2,
  "retrieval_hops_driver": "llm",
  "rerank_model": "cross-encoder/ms-marco-MiniLM-L-6-v2",
  "rerank_enabled": true,
  "ingest_batch_size": 500,
  "exclude": [
    "Leo Tolstoy"
  ],
  "fiction_tags": [
    "Fiction",
    "Short Stories",
    "Literary"
  ],
  "ocr_enabled": false,
  "ocr_merge": true,
  "ocr_backend": "tesseract",
  "ocr_char_threshold": 50,
  "ocr_languages": [
    "en"
  ],
  "lexical_backend": "auto",
  "sets": {
    "veracrypt1": {
      "path": "/path/to/your/library",
      "kind": "local"
    },
    "nlp_books": {
      "path": "/path/to/nlp/books",
      "kind": "local"
    }
  }
}