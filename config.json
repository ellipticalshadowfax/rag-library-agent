{
  "embed_model": "intfloat/multilingual-e5-small",
  "embed_device": "cpu",
  "embed_dim": 384,
  "chunk_tokens": 330,
  "chunk_overlap": 60,
  "chunking_strategy": "parent_child",
  "parent_tokens": 1200,
  "agentic_enabled": true,
  "agentic_max_steps": 3,
  "agentic_strategy": "auto",
  "llm_base_url": "http://localhost:1234/v1",
  "llm_model": "default",
  "llm_temperature": 0.3,
  "llm_max_tokens": 2048,
  "context_word_budget": 1000,
  "chunk_word_cap": 200,
  "retrieval_top_k": 10,
  "relevance_threshold": 0.8,
  "max_retrieval_hops": 2,
  "retrieval_hops_driver": "llm",
  "rerank_model": "cross-encoder/ms-marco-MiniLM-L-6-v2",
  "rerank_enabled": true,
  "ingest_batch_size": 500,
  "exclude": [
    "Leo Tolstoy"
  ],
  "fiction_tags": [
    "Fiction",
    "Short Stories",
    "Literary"
  ],
  "ocr_enabled": false,
  "ocr_merge": true,
  "ocr_backend": "tesseract",
  "ocr_char_threshold": 50,
  "ocr_languages": [
    "en"
  ],
  "lexical_backend": "auto",
  "sets": {
    "veracrypt1": {
      "path": "/path/to/your/library",
      "kind": "local"
    },
    "nlp_books": {
      "path": "/path/to/nlp/books",
      "kind": "local"
    }
  }
}